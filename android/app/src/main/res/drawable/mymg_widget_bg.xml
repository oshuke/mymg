<?xml version="1.0" encoding="utf-8"?>
<!-- 小米同款：淡蓝磨砂圆角卡片 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="@color/widget_bg_mid"
        android:endColor="@color/widget_bg_end"
        android:startColor="@color/widget_bg_start"
        android:type="linear" />
    <corners android:radius="22dp" />
    <stroke
        android:width="0.5dp"
        android:color="#14000000" />
</shape>
