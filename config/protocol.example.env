# =====================================================================
# MYMG 协议参数模板（示例值全部为空）
# ---------------------------------------------------------------------
# 本仓库不包含任何厂商协议值。要让「车况 / 远程控车」真正可用，
# 需要你自己准备下表中的值，然后：
#
#   cp config/protocol.example.env config/protocol.env
#   # 编辑 config/protocol.env 填入真实值（该文件已被 .gitignore 忽略）
#   set -a; . config/protocol.env; set +a
#   flutter build apk --release --target-platform android-arm64
#
# 原理：这些变量在 Rust 编译期通过 option_env! 读取并内联进二进制，
# 因此构建时必须存在于环境中。详见 docs/PROTOCOL.md。
# =====================================================================

# ---------- 服务器 ----------
# 车况接口完整 URL（含 https://）
MYMG_STATUS_URL=
# 车况域名的 host（不带 https://，不带路径）
MYMG_HOST_STATUS=
# 登录/鉴权域名的 host（不带 https://，不带路径）
MYMG_HOST_LOGIN=

# ---------- 接口路径 ----------
# 车况接口路径
MYMG_PATH_STATUS_V11=
# 由 token 换取车辆状态的路径
MYMG_PATH_STATUS_V12=
# 状态查询（备用）路径
MYMG_PATH_STATUS_REQUEST=
# 短信验证码发送
MYMG_PATH_SEND_SMS=
# 短信验证码登录
MYMG_PATH_LOGIN=
# 已绑定车辆列表
MYMG_PATH_VEHICLE_LIST=
# 外部服务 token 换取
MYMG_PATH_OUTSIDE_TOKEN=
# 用户信息
MYMG_PATH_USER_INFO=

# ---------- 登录参数 ----------
# 图形/滑块验证码的 captchaId
MYMG_CAPTCHA_ID=
# 应用标识（请求体 appId 一类）
MYMG_APP_CODE=
# 品牌编号
MYMG_BRAND_CODE=
# 客户端版本标识
MYMG_APP_VERSION=

# ---------- 控车路径 ----------
MYMG_PATH_RANDOM_CODE=
MYMG_PATH_CHECK_PIN=
MYMG_PATH_LOCK=
MYMG_PATH_UNLOCK=
MYMG_PATH_UNLOCK_BOOT=
MYMG_PATH_FIND=
MYMG_PATH_AC_ON=
MYMG_PATH_AC_OFF=
MYMG_PATH_WIN_OPEN=
MYMG_PATH_WIN_CLOSE=
MYMG_PATH_CONTROL_STATUS=
MYMG_PATH_BLE_KEYS=

# ---------- 签名 ----------
# 品牌 A（如名爵）的签名密钥 / 应用类型
MYMG_APP_ID_A=
MYMG_APP_TYPE_A=
# 品牌 B（如荣威）的签名密钥 / 应用类型
MYMG_APP_ID_B=
MYMG_APP_TYPE_B=
# 请求体中的 appId
MYMG_BODY_APP_ID_A=
MYMG_BODY_APP_ID_B=
# deviceId 计算用的包名
MYMG_DEVICE_PKG=

# ---------- 设备指纹（可选，留空则用 generic） ----------
MYMG_MOBILE_TYPE=
MYMG_MOBILE_BRAND=

# =====================================================================
# 以下为 Dart 侧（--dart-define 注入，不参与 Rust 编译期）
# 用 flutter build apk --dart-define=KEY=VALUE 传入
# =====================================================================
# 数字钥匙 GATT 服务 UUID（浮层/扫描页展示用；开源版原生无内置实现）
# MYMG_BLE_SERVICE_UUID=
# 官方 App 包名（仅用于「打开官方 App」按钮；不填则该按钮无效）
# MYMG_OFFICIAL_PKG=
# 访问令牌后缀校验（留空则不校验）
# MYMG_TOKEN_SUFFIX=
# 前端滑块验证码 captchaId（与 MYMG_CAPTCHA_ID 同值）
# MYMG_CAPTCHA_ID=
